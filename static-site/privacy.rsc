1:[["$","section",null,{"className":"page-intro container","children":[["$","p",null,{"className":"page-intro-english","aria-hidden":"true","children":["Privacy policy",["$","span",null,{"children":"."}]]}],["$","div",null,{"className":"page-intro-bottom","children":[["$","h1",null,{"children":"プライバシーポリシー"}],["$","p",null,{"children":"個人情報の取り扱いについて"}]]}]]}],["$","div",null,{"className":"policy-content container","children":[["$","div",null,{"className":"form-notice","children":[["$","strong",null,{"children":"公開準備中の方針案です。"}],["$","p",null,{"children":"本ページは確定前の案です。窓口、保管方法、委託先、安全管理措置などを実際の運用に合わせて確認し、正式な方針として公開します。現在のお問い合わせ画面から情報は送信されません。"}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"01　基本方針"}],["$","p",null,{"children":"株式会社Bridge（以下「当社」）は、事業活動において取り扱う個人情報の重要性を認識し、個人情報の保護に関する法令等に沿った適切な取り扱いを基本方針とします。"}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"02　取得する情報と利用目的"}],["$","p",null,{"children":"お問い合わせ窓口の開設後は、会社名、氏名、メールアドレス、ご相談内容など、ご本人が入力した情報を、次の目的で利用することを予定しています。"}],["$","ul",null,{"children":[["$","li",null,{"children":"お問い合わせ内容の確認と回答"}],["$","li",null,{"children":"ご相談に関連するサービスの説明、提案、連絡"}],["$","li",null,{"children":"依頼された支援の検討および対応"}]]}],["$","p",null,{"children":"上記以外の情報の取得や利用を行う場合は、その内容と目的に合わせて本方針を整えます。"}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"03　第三者への提供・業務委託"}],["$","p",null,{"children":"個人データの第三者への提供は、法令上認められる場合等を除き、ご本人の同意を得ることを基本とします。取り扱いを委託する場合の委託先、管理方法、必要な監督については、利用サービスを決定したうえで確認します。"}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"04　安全管理と保管"}],["$","p",null,{"children":"情報へのアクセス権限、保存先、保存期間、不要となった情報の削除、従業者・委託先の管理など、実施する安全管理措置を運用に合わせて定めます。正式公開時には、実際に講じる措置について必要な内容を記載します。"}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"05　開示・訂正・利用停止等"}],["$","p",null,{"children":"ご本人からの利用目的の通知、開示、訂正、利用停止等のご相談に対応する窓口と手続きを設けます。本人確認の方法、対応手順、手数料の有無などは、窓口の開設に合わせて案内します。"}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"06　Cookie・外部サービス"}],["$","p",null,{"children":"現時点のサイトには、当社がアクセス解析や広告配信のために設置したタグはありません。公開時に利用するホスティング、問い合わせ受付、アクセス解析等のサービスを確認し、Cookieの利用や外部への情報送信がある場合は、その内容に合わせて案内を整えます。"}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"07　事業者・お問い合わせ窓口"}],["$","dl",null,{"className":"policy-company","children":[["$","div",null,{"children":[["$","dt",null,{"children":"事業者"}],["$","dd",null,{"children":"株式会社Bridge"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"所在地"}],["$","dd",null,{"children":"大阪府藤井寺市"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"窓口"}],["$","dd",null,{"children":"開設準備中"}]]}]]}],["$","p",null,{"children":"正式公開に向けて、詳細な所在地、代表者、連絡先および受付手順を確定します。"}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"08　方針の見直し"}],["$","p",null,{"children":"事業内容、利用するサービス、運用の変更等に応じて方針を見直します。制定日・改定日は、正式な方針の公開時に記載します。"}]]}],["$","p",null,{"className":"policy-reference","children":["作成時の参考：",["$","a",null,{"href":"https://www.ppc.go.jp/personalinfo/faq/APPI_QA/","target":"_blank","rel":"noopener noreferrer","children":"個人情報保護委員会「個人情報保護法ガイドラインに関するQ&A」"}]]}]]}]]
